# LabGate — copy to .env.local and fill in. Never commit .env.local.

# Standalone mongod (NOT a replica set — see SPEC §19.1)
MONGODB_URI=mongodb://localhost:27020/labgate

# MUST be different from the CMMS's AUTH_SECRET.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# The real public origin of this app.
AUTH_URL=http://localhost:3001

# QC attachments — an absolute path OUTSIDE the app tree, so a rebuild or a
# container swap never deletes them (SPEC §16).
UPLOAD_DIR=/Users/yunis/Projects/labgate-uploads

# Comma-separated LAN origins allowed to reach the dev server.
ALLOWED_DEV_ORIGINS=
